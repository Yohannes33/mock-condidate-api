# ==============================================================================
# Mock Candidate API - Environment Variables
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# The mock can run in Standalone Mode (no Frappe required) or Connected Mode.
# ==============================================================================

# Port the mock server listens on (default: 8001)
PORT=8001

# --- Outbound Webhook (Frappe Candidate Intake) ---
# Where to POST the form-encoded candidate payload upon candidate creation.
# If unset/empty, the mock is fully inert and makes no outbound webhook calls (ideal for standalone testing).
# Local Frappe:
WEBHOOK_URL=http://localhost:8000/api/method/mmcy_fleet_management.api.dispatch.receive_candidate
# Remote / Staging Frappe:
# WEBHOOK_URL=https://hrms-dev.mmcytech.com/api/method/mmcy_fleet_management.api.dispatch.receive_candidate

# --- Frappe Base URL ---
# Origin used to build Frappe RPC URLs (e.g., request_reservation).
# If left empty, automatically derived from WEBHOOK_URL's origin.
FRAPPE_BASE_URL=

# --- Frappe API Auth Token ---
# User API key:secret pair generated in Frappe desk (e.g. Administrator or recruiter user).
# Sent as 'Authorization: token <api_key>:<api_secret>' on outbound webhook and RPC calls.
# If left empty, outbound calls are sent without an auth header.
API_KEY=

# --- Google Places API (Optional) ---
# API key used to resolve raw landmark text into {place_id, display_name, formatted_address, lat, lng}.
# If unset/empty, place resolution returns null coordinates gracefully without error.
GOOGLE_API_KEY=

# --- Inbound Reservation Callback Auth ---
# Shared secret that Frappe must send as 'Authorization: token <EXTERNAL_RESERVATION_TOKEN>'
# on PUT /api/external/reservation.
# Must match 'external_reservation_token' in Frappe's site_config.json.
# If left empty, auth check on this endpoint is disabled (accepts any caller).
EXTERNAL_RESERVATION_TOKEN=mock-reservation-secret

# --- Reservation Auto-Confirmation ---
# Automatically call Frappe's request_reservation after receiving "Ready for Reservation" PUT.
# false (default): reservation is driven manually (via Web UI or POST /api/reservations/:id/request-reservation)
# true: automatically dispatches request_reservation immediately
AUTO_CONFIRM_RESERVATION=false
